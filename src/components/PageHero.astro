---
// Shared header for top-level pages.
interface Props { emoji: string; title: string; lead?: string; tone?: 'brand' | 'accent' | 'neutral' }
const { emoji, title, lead, tone = 'brand' } = Astro.props
const bg = { brand: 'bg-brand-soft', accent: 'bg-accent-soft', neutral: 'bg-surface-2' }[tone]
---

<header class="mx-auto max-w-6xl px-4 pb-8 pt-10 sm:px-6 sm:pt-14">
  <span aria-hidden="true" class:list={['grid h-16 w-16 place-items-center rounded-3xl text-4xl', bg]}>{emoji}</span>
  <h1 class="mt-5 text-[28px] font-extrabold leading-tight tracking-tight sm:text-[40px]">{title}</h1>
  {lead && <p class="mt-3 max-w-2xl text-lg text-ink-2">{lead}</p>}
  <slot />
</header>
