---
// One headline on the AI 新聞 page; opens the original article in a new tab.
interface Props { it: { title: string; link: string; date: string; source: string } }
const { it } = Astro.props
const day = new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', month: 'numeric', day: 'numeric' }).format(new Date(it.date))
---

<li>
  <a class="block px-4 py-3 transition-colors hover:bg-surface-2" href={it.link} target="_blank" rel="noopener noreferrer">
    <span class="block font-bold leading-[1.6]">{it.title}</span>
    <span class="mt-0.5 block text-xs font-bold text-ink-2">{day}・{it.source}<span class="sr-only">（在新分頁開啟）</span></span>
  </a>
</li>
