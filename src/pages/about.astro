---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { url } from '../lib/url'

const stack = [
  { name: 'Astro', role: '把 Markdown 教材組成網站，只在需要互動的地方載入 JavaScript' },
  { name: 'Tailwind CSS', role: '把設計規範（色彩、字級、間距）變成可重複使用的樣式' },
  { name: 'Vue', role: '互動元件：情境測驗、判斷流程圖、學習進度' },
  { name: 'GitHub Actions', role: '推送後自動做安全檢查、建置、部署到 GitHub Pages' },
  { name: 'Google Apps Script＋試算表', role: '模擬考後端：登入驗證、題庫、批改（建置中）' }
]
---

<BaseLayout title="關於本站" description="三人讀書會的 iPAS 學習網站，也是一個與 AI 協作開發的實作專案。">
  <PageHero emoji="🌱" title="關於本站" lead="三人讀書會準備 iPAS AI 應用規劃師（初級）的學習網站，也是一個「與 AI 協作開發網站」的實作專案：架構、程式、設計與教材都是和 AI 程式助理 Claude Code 一起完成的。" />

  <div class="mx-auto max-w-6xl space-y-14 px-4 pb-16 sm:px-6">
    <section aria-labelledby="arch-title">
      <h2 id="arch-title" class="text-2xl font-extrabold tracking-tight">系統架構</h2>
      <p class="mt-2 max-w-2xl text-ink-2">公開的部分任何人都看得到；題庫和個人資料只存在私人後端。</p>

      <div class="mt-6 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
        <div class="rounded-[var(--radius-card)] border-2 border-brand bg-surface p-5">
          <p class="text-sm font-extrabold text-brand">🌐 公開・GitHub Pages</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-[15px] leading-[1.75]">
            <li>教學單元、互動圖解、延伸影片連結</li>
            <li>示範測驗（瀏覽器內批改）</li>
            <li>模擬考介面</li>
          </ul>
        </div>
        <div aria-hidden="true" class="grid place-items-center text-2xl font-extrabold text-ink-2"><span class="lg:hidden">↓↑</span><span class="hidden lg:inline">⇄</span></div>
        <div class="rounded-[var(--radius-card)] border-2 border-accent bg-surface p-5">
          <p class="text-sm font-extrabold text-accent">🔒 私人・Google Apps Script</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-[15px] leading-[1.75]">
            <li>驗證 Google 登入＋白名單</li>
            <li>出題時不送答案</li>
            <li>交卷後由伺服器批改、記錄</li>
          </ul>
        </div>
        <div aria-hidden="true" class="grid place-items-center text-2xl font-extrabold text-ink-2"><span class="lg:hidden">↓↑</span><span class="hidden lg:inline">⇄</span></div>
        <div class="rounded-[var(--radius-card)] border-2 border-dashed border-line bg-surface p-5">
          <p class="text-sm font-extrabold text-ink-2">🗄️ 私人・Google 試算表</p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-[15px] leading-[1.75]">
            <li>題庫</li>
            <li>成員白名單</li>
            <li>作答紀錄</li>
          </ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="stack-title">
      <h2 id="stack-title" class="text-2xl font-extrabold tracking-tight">使用的技術</h2>
      <dl class="mt-6 divide-y divide-line overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
        {stack.map(s => (
          <div class="grid gap-1 px-5 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <dt class="font-extrabold">{s.name}</dt>
            <dd class="text-ink-2">{s.role}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="grid gap-5 md:grid-cols-2" aria-label="設計與資安文件">
      <a href={url('design/')} class="rounded-[var(--radius-card)] bg-brand-soft p-6 transition-transform hover:-translate-y-1">
        <span aria-hidden="true" class="text-3xl">🎨</span>
        <p class="mt-3 text-xl font-extrabold">設計規範</p>
        <p class="mt-2 leading-[1.8] text-ink-2">設計原則、色彩、字體、元件，以及每個決定背後的理由。</p>
      </a>
      <a href={url('security/')} class="rounded-[var(--radius-card)] bg-accent-soft p-6 transition-transform hover:-translate-y-1">
        <span aria-hidden="true" class="text-3xl">🛡️</span>
        <p class="mt-3 text-xl font-extrabold">資安設計</p>
        <p class="mt-2 leading-[1.8] text-ink-2">威脅模型、分層防護措施，以及誠實列出的已知限制。</p>
      </a>
    </section>
  </div>
</BaseLayout>
