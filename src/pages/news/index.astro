---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import archive from '../../data/news-archive.json'
import Card from '../../components/RadarCard.astro'
import Row from '../../components/NewsRow.astro'
import { radar } from '../../data/radar'
import { topics, topicOf, isTechNews } from '../../data/news-topics'
import { url } from '../../lib/url'

// Headlines come from the archive that scripts/update-news.mjs refreshes every morning (kept for 30 days).
// Only new-technology headlines are shown, grouped by exam topic (rules in src/data/news-topics.ts).
interface NewsItem { title: string; link: string; date: string; source: string; lang: string }
const { items, failed, updatedAt, keepDays, sources } = archive as { items: NewsItem[]; failed: string[]; updatedAt: string; keepDays: number; sources: { name: string; lang: string }[] }
const zh = items.filter(i => i.lang === 'zh')
const tech = zh.filter(i => isTechNews(i.title))
const SHOW = 5

const tz = 'Asia/Taipei'
const groups = topics
  .map(t => ({ topic: t, list: tech.filter(i => topicOf(i.title).id === t.id) }))
  .filter(g => g.list.length > 0)
const updated = new Intl.DateTimeFormat('zh-TW', { timeZone: tz, dateStyle: 'long', timeStyle: 'short' }).format(new Date(updatedAt))

const [latest, ...older] = radar

const timeline = [
  { when: '2025/11', what: 'MCP、A2A、Solution Graph、GPT-OSS、Context Engineering' },
  { when: '2026/03', what: 'Sora 的 C2PA、Veo 的 SynthID、AgentKit、LoRA、RFT' },
  { when: '2026/05', what: 'Claude Code、Dify、Extended Thinking、CLIP、Webhook' },
  { when: '2026/08', what: 'MCP vs Skill、Thinking Budget、模型路由、Reranker' }
]
---

<BaseLayout title="AI 新聞" description="每週挑出可能變成 iPAS 考題的新技術並用白話解說，加上每天自動整理、依考試主題分類的新技術新聞。">
  <PageHero emoji="📡" title="AI 新聞" lead="考題每一梯次都會加入新技術。這裡只收「新東西出現」的新聞，略過股價、財報和八卦；每週再挑幾個可能會考的新技術，用白話解說。" />

  <div class="mx-auto grid max-w-6xl gap-10 px-4 pb-16 sm:px-6 lg:grid-cols-[1fr_20rem]">
    <div class="min-w-0 space-y-12">
      <section aria-labelledby="weekly-title">
        <h2 id="weekly-title" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><span aria-hidden="true">🆕</span>本週新技術</h2>
        <p class="mt-2 text-ink-2">每週從新聞中挑出可能出成考題的新技術與法規：它是什麼、為什麼可能會考、對應哪一課。</p>
        {latest && (
          <div class="mt-6">
            <p class="text-sm font-extrabold text-brand">{latest.label}</p>
            <ul class="mt-3 grid gap-4 md:grid-cols-2">
              {latest.items.map(r => <Card r={r} />)}
            </ul>
          </div>
        )}
        {older.length > 0 && (
          <div class="mt-8 space-y-2">
            <h3 class="text-sm font-extrabold text-ink-2">之前的解說</h3>
            {older.map(issue => (
              <details class="rounded-[var(--radius-card)] border border-line bg-surface">
                <summary class="flex min-h-12 cursor-pointer items-center px-4 font-bold">{issue.label}<span class="ml-2 text-sm text-ink-2">・{issue.items.length} 則</span></summary>
                <ul class="grid gap-4 border-t border-line p-4 md:grid-cols-2">
                  {issue.items.map(r => <Card r={r} />)}
                </ul>
              </details>
            ))}
          </div>
        )}
      </section>

      <section aria-labelledby="news-title">
        <h2 id="news-title" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><span aria-hidden="true">📰</span>新技術新聞</h2>
        <p class="mt-2 text-ink-2">近 {keepDays} 天的新技術新聞，依考試主題分類，每類先顯示最新 {SHOW} 則。點標題會在新分頁開啟原文。</p>
        {groups.length === 0 && (
          <p class="mt-6 rounded-[var(--radius-card)] bg-surface-2 p-5 text-ink-2">目前沒有新聞，明天會再自動更新一次。</p>
        )}
        {groups.map(({ topic, list }) => (
          <div class="mt-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-lg font-extrabold"><span aria-hidden="true">{topic.emoji}</span> {topic.name}<span class="ml-1 text-sm font-bold text-ink-2">・{list.length} 則</span></h3>
              {topic.lesson && <a class="text-sm font-bold text-brand underline underline-offset-4" href={url(topic.lesson.path)}>📖 {topic.lesson.label}</a>}
            </div>
            <ul class="mt-2 divide-y divide-line overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
              {list.slice(0, SHOW).map(it => <Row it={it} />)}
            </ul>
            {list.length > SHOW && (
              <details class="mt-2 rounded-[var(--radius-card)] border border-line bg-surface">
                <summary class="flex min-h-12 cursor-pointer items-center px-4 text-sm font-bold text-brand">再看 {list.length - SHOW} 則</summary>
                <ul class="divide-y divide-line border-t border-line">
                  {list.slice(SHOW).map(it => <Row it={it} />)}
                </ul>
              </details>
            )}
          </div>
        ))}
      </section>

      <section aria-labelledby="tl-title">
        <h2 id="tl-title" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><span aria-hidden="true">🗓️</span>歷屆考題出現過的新主題</h2>
        <p class="mt-2 text-ink-2">新技術通常在發布後 3～9 個月出現在考題中。</p>
        <ol class="mt-6 space-y-4 border-l-2 border-line pl-6">
          {timeline.map(t => (
            <li class="relative">
              <span aria-hidden="true" class="absolute -left-[33px] top-2 h-4 w-4 rounded-full border-4 border-canvas bg-brand"></span>
              <p class="text-sm font-extrabold text-brand">{t.when} 考試</p>
              <p class="mt-1 font-semibold leading-[1.75]">{t.what}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="h-fit space-y-5 rounded-[var(--radius-card)] bg-info-soft p-6 lg:sticky lg:top-24">
      <div>
        <p class="font-extrabold text-info">🔄 自動更新</p>
        <p class="mt-1 text-[15px] leading-[1.75]">新聞每天早上自動更新，保留 {keepDays} 天。<br />最後更新：{updated}</p>
        {failed.length > 0 && <p class="mt-2 text-sm leading-[1.7]">這次沒抓到：{failed.join('、')}，下次更新會再試。</p>}
      </div>
      <div>
        <p class="font-extrabold text-info">🧹 篩選方式</p>
        <p class="mt-1 text-[15px] leading-[1.75]">近 {keepDays} 天共 {zh.length} 則 AI 新聞，只留下宣布新模型、新工具、新方法、新規範的 {tech.length} 則；股價、財報、人事和資料中心等新聞不列出。</p>
      </div>
      <div>
        <p class="font-extrabold text-info">📚 新聞來源</p>
        <ul class="mt-1 space-y-0.5 text-[15px] leading-[1.75]">
          {sources.map(s => <li>{s.name}</li>)}
        </ul>
        <p class="mt-2 text-sm leading-[1.7]">本站只列出標題與連結，內容版權屬於各媒體。</p>
      </div>
      <div>
        <p class="font-extrabold text-info">🆕 新技術解說收錄標準</p>
        <ul class="mt-1 list-disc space-y-0.5 pl-5 text-[15px] leading-[1.75]">
          <li>能對應到官方評鑑代碼</li>
          <li>能出成情境題</li>
          <li>讀過原文、附上來源</li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
