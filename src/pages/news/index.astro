---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import { getNews, sources } from '../../lib/news'
import { radar } from '../../data/radar'
import { url } from '../../lib/url'

const { items, failed, updatedAt } = await getNews()
const zh = items.filter(i => i.lang === 'zh')
const en = items.filter(i => i.lang === 'en')

const tz = 'Asia/Taipei'
const dayKey = (iso: string) => new Intl.DateTimeFormat('zh-TW', { timeZone: tz, month: 'long', day: 'numeric', weekday: 'short' }).format(new Date(iso))
const groupByDay = (list: typeof items) => {
  const groups: { day: string; list: typeof items }[] = []
  for (const it of list) {
    const day = dayKey(it.date)
    const last = groups[groups.length - 1]
    if (last?.day === day) last.list.push(it); else groups.push({ day, list: [it] })
  }
  return groups
}
const zhDays = groupByDay(zh)
const updated = new Intl.DateTimeFormat('zh-TW', { timeZone: tz, dateStyle: 'long', timeStyle: 'short' }).format(new Date(updatedAt))

const timeline = [
  { when: '2025/11', what: 'MCP、A2A、Solution Graph、GPT-OSS、Context Engineering' },
  { when: '2026/03', what: 'Sora 的 C2PA、Veo 的 SynthID、AgentKit、LoRA、RFT' },
  { when: '2026/05', what: 'Claude Code、Dify、Extended Thinking、CLIP、Webhook' },
  { when: '2026/08', what: 'MCP vs Skill、Thinking Budget、模型路由、Reranker' }
]
const ext = { target: '_blank', rel: 'noopener noreferrer' }
---

<BaseLayout title="AI 新知" description="每天自動更新的 AI 新聞，加上每月整理的「考點雷達」：哪些新技術可能變成 iPAS 考題。">
  <PageHero emoji="📡" title="AI 新知" lead="AI 技術變化很快，考題每一梯次都會加入新東西。這裡每天自動整理最新的 AI 新聞，每月再挑出「可能變成考題」的重點。" />

  <div class="mx-auto grid max-w-6xl gap-10 px-4 pb-16 sm:px-6 lg:grid-cols-[1fr_20rem]">
    <div class="min-w-0 space-y-12">
      <section aria-labelledby="radar-title">
        <h2 id="radar-title" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><span aria-hidden="true">🎯</span>考點雷達</h2>
        <p class="mt-2 text-ink-2">每月從新聞中挑出可能出成考題的技術與法規，附上對應的範圍代碼和課程。</p>
        {radar.map(issue => (
          <div class="mt-6">
            <p class="text-sm font-extrabold text-brand">{issue.month}</p>
            <ul class="mt-3 grid gap-4 md:grid-cols-2">
              {issue.items.map(r => (
                <li class="flex flex-col rounded-[var(--radius-card)] border border-line bg-surface p-5 shadow-[var(--shadow-soft)]">
                  <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
                    <span class="rounded-full bg-brand-soft px-2.5 py-1 text-brand">{r.code}</span>
                    <span class="text-ink-2">{r.date}</span>
                  </div>
                  <p class="mt-2 text-lg font-extrabold leading-[1.5]">{r.title}</p>
                  <p class="mt-2 flex-1 text-[15px] leading-[1.75] text-ink-2">{r.why}</p>
                  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm font-bold">
                    <a class="text-brand underline underline-offset-4" href={url(r.lesson.path)}>📖 {r.lesson.label}</a>
                    <a class="text-ink-2 underline underline-offset-4 hover:text-ink" href={r.source.url} {...ext}>來源：{r.source.label} ↗</a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section aria-labelledby="news-title">
        <h2 id="news-title" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><span aria-hidden="true">📰</span>最新 AI 新聞</h2>
        <p class="mt-2 text-ink-2">近兩週的中文 AI 新聞，點標題會在新分頁開啟原文。</p>
        {zhDays.length === 0 ? (
          <p class="mt-6 rounded-[var(--radius-card)] bg-surface-2 p-5 text-ink-2">這次更新沒有抓到新聞，明天會再自動更新一次。</p>
        ) : zhDays.map(g => (
          <div class="mt-6">
            <h3 class="text-sm font-extrabold text-ink-2">{g.day}</h3>
            <ul class="mt-2 divide-y divide-line overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
              {g.list.map(it => (
                <li>
                  <a class="block px-4 py-3 transition-colors hover:bg-surface-2" href={it.link} {...ext}>
                    <span class="block font-bold leading-[1.6]">{it.title}</span>
                    <span class="mt-0.5 block text-xs font-bold text-ink-2">{it.source}<span class="sr-only">（在新分頁開啟）</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        {en.length > 0 && (
          <details class="mt-8 rounded-[var(--radius-card)] border border-line bg-surface">
            <summary class="flex min-h-12 cursor-pointer items-center px-5 font-extrabold">🌐 AI 公司官方公告（英文，{en.length} 則）</summary>
            <ul class="divide-y divide-line border-t border-line">
              {en.map(it => (
                <li>
                  <a class="block px-5 py-3 transition-colors hover:bg-surface-2" href={it.link} {...ext}>
                    <span class="block font-bold leading-[1.6]">{it.title}</span>
                    <span class="mt-0.5 block text-xs font-bold text-ink-2">{it.source}・{dayKey(it.date)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>

      <section aria-labelledby="tl-title">
        <h2 id="tl-title" class="flex items-center gap-2 text-2xl font-extrabold tracking-tight"><span aria-hidden="true">🗓️</span>歷屆考題出現過的新主題</h2>
        <p class="mt-2 text-ink-2">新技術通常在發布後 3～9 個月出現在考題中。</p>
        <ol class="mt-6 space-y-4 border-l-2 border-line pl-6">
          {timeline.map(t => (
            <li class="relative">
              <span aria-hidden="true" class="absolute -left-[33px] top-2 h-4 w-4 rounded-full border-4 border-canvas bg-brand"></span>
              <p class="text-sm font-extrabold text-brand">{t.when} 考試</p>
              <p class="mt-1 font-semibold leading-[1.75]">{t.what}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <aside class="h-fit space-y-5 rounded-[var(--radius-card)] bg-info-soft p-6 lg:sticky lg:top-24">
      <div>
        <p class="font-extrabold text-info">🔄 自動更新</p>
        <p class="mt-1 text-[15px] leading-[1.75]">新聞每天早上自動更新。<br />最後更新：{updated}</p>
        {failed.length > 0 && <p class="mt-2 text-sm leading-[1.7]">這次沒抓到：{failed.join('、')}，下次更新會再試。</p>}
      </div>
      <div>
        <p class="font-extrabold text-info">📚 新聞來源</p>
        <ul class="mt-1 space-y-0.5 text-[15px] leading-[1.75]">
          {sources.map(s => <li>{s.name}{s.lang === 'en' ? '（英文）' : ''}</li>)}
        </ul>
        <p class="mt-2 text-sm leading-[1.7]">綜合科技媒體只保留標題和 AI 相關的新聞。本站只列出標題與連結，內容版權屬於各媒體。</p>
      </div>
      <div>
        <p class="font-extrabold text-info">🎯 考點雷達收錄標準</p>
        <ul class="mt-1 list-disc space-y-0.5 pl-5 text-[15px] leading-[1.75]">
          <li>能對應到官方評鑑代碼</li>
          <li>能出成情境題</li>
          <li>附上查證過的來源</li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>
