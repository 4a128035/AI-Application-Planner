---
import BaseLayout from '../layouts/BaseLayout.astro'
import { url } from '../lib/url'
---

<BaseLayout title="找不到頁面">
  <section class="mx-auto grid max-w-xl place-items-center px-4 py-24 text-center">
    <span aria-hidden="true" class="text-7xl">🧭</span>
    <h1 class="mt-6 text-3xl font-extrabold">這一頁迷路了</h1>
    <p class="mt-3 text-ink-2">網址可能打錯，或這個單元還沒上線。</p>
    <a href={url('')} class="mt-8 inline-flex min-h-12 items-center rounded-[var(--radius-btn)] bg-brand px-6 font-extrabold text-on-brand">回到首頁</a>
  </section>
</BaseLayout>
