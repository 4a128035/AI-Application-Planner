---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import Callout from '../components/Callout.astro'
import Misconception from '../components/Misconception.astro'
import Badge from '../components/Badge.astro'
import Quiz from '../components/Quiz.vue'
import DecisionTree from '../components/DecisionTree.vue'

const principles = [
  { emoji: '1️⃣', title: '一次只講一個概念', how: '內容切成卡片、段落短、每段先講結論。' },
  { emoji: '📍', title: '永遠知道自己讀到哪', how: '閱讀進度條、預估時間、單元完成狀態。' },
  { emoji: '👆', title: '每 2～3 分鐘一個互動', how: '比喻卡、點開的誤區、流程圖、小測驗交錯出現。' },
  { emoji: '🤝', title: '親切但不幼稚', how: '暖色與 emoji 帶來友善感，字體與排版維持成人質感。' }
]

const colors = [
  { name: 'canvas', use: '頁面背景（暖米白，比純白不刺眼）', light: '#FBF8F3', dark: '#1A1917', cls: 'bg-canvas border border-line' },
  { name: 'surface', use: '卡片', light: '#FFFFFF', dark: '#24221F', cls: 'bg-surface border border-line' },
  { name: 'ink', use: '內文（對比 ≥ 12:1）', light: '#2B2A28', dark: '#EDEAE4', cls: 'bg-ink' },
  { name: 'ink-2', use: '次要文字（對比 ≥ 5:1）', light: '#6B6760', dark: '#A8A29A', cls: 'bg-ink-2' },
  { name: 'brand', use: '主色・科目一（對比 5.5:1）', light: '#0F766E', dark: '#2DD4BF', cls: 'bg-brand' },
  { name: 'accent', use: '輔色・科目二', light: '#B93D0B', dark: '#FB923C', cls: 'bg-accent' },
  { name: 'ok', use: '答對', light: '#137336', dark: '#4ADE80', cls: 'bg-ok' },
  { name: 'bad', use: '答錯', light: '#BE123C', dark: '#FB7185', cls: 'bg-bad' },
  { name: 'warn', use: '考試陷阱', light: '#B45309', dark: '#FBBF24', cls: 'bg-warn' },
  { name: 'info', use: '生活比喻', light: '#1D4ED8', dark: '#93C5FD', cls: 'bg-info' }
]

const typeScale = [
  { label: 'H1 頁面標題', size: '手機 28px／電腦 40px', cls: 'text-[28px] sm:text-[40px] font-extrabold leading-tight' },
  { label: 'H2 段落標題', size: '24px', cls: 'text-2xl font-extrabold' },
  { label: 'H3 小標題', size: '20px', cls: 'text-xl font-bold' },
  { label: '內文', size: '17px・行高 1.8', cls: 'text-[17px] leading-[1.8]' },
  { label: '輔助文字', size: '15px', cls: 'text-[15px] text-ink-2' }
]

const breakpoints = [
  { range: '< 768px', name: '手機', layout: '單欄・底部分頁列・段落改為橫向捲動標籤' },
  { range: '768–1023px', name: '平板', layout: '單欄・上方導覽列' },
  { range: '≥ 1024px', name: '電腦', layout: '左側固定目錄＋內容欄（每行約 38 字）' }
]

const demoQuiz = [{
  id: 'demo-1', code: 'L11302',
  stem: '（示範題）某店家有大量未標註的顧客消費紀錄，想自動找出消費習慣相似的客群。最適合哪種學習方式？',
  answer: 1,
  options: [
    { text: '監督式學習', why: '需要標好的答案，這題沒有標籤。' },
    { text: '非監督式學習（分群）', why: '沒有標籤＋找相似群體＝分群。' },
    { text: '強化式學習', why: '沒有行動與獎懲的試錯過程。' },
    { text: '半監督式學習', why: '這題沒有任何標註資料。' }
  ]
}]

const demoTree = {
  title: '示範：要不要帶傘？',
  start: 'rain',
  nodes: { rain: { q: '降雨機率超過 50% 嗎？', choices: [{ label: '是', to: 'yes' }, { label: '否', to: 'no' }] } },
  results: {
    yes: { emoji: '☂️', title: '帶傘', desc: '流程圖元件一步一步引導判斷。' },
    no: { emoji: '😎', title: '不用帶', desc: '每一步都可以回頭重選。' }
  }
}
---

<BaseLayout title="設計規範" description="AI 讀書會的設計系統：設計原則、色彩、字體、間距與元件。">
  <PageHero emoji="🎨" title="設計規範" lead="這個網站的每個畫面都從這份規範長出來。讀者是兩位不懂 AI、下班後才有空讀書的上班族，所以所有決定都以「讀得下去、讀得完」為優先。" />

  <div class="mx-auto max-w-6xl space-y-16 px-4 pb-16 sm:px-6">
    <section aria-labelledby="p-title">
      <h2 id="p-title" class="text-2xl font-extrabold tracking-tight">設計原則</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {principles.map(p => (
          <li class="rounded-[var(--radius-card)] border border-line bg-surface p-5 shadow-[var(--shadow-soft)]">
            <p class="text-lg font-extrabold"><span aria-hidden="true">{p.emoji}</span> {p.title}</p>
            <p class="mt-1 text-ink-2">{p.how}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="c-title">
      <h2 id="c-title" class="text-2xl font-extrabold tracking-tight">色彩</h2>
      <p class="mt-2 max-w-2xl text-ink-2">所有顏色都是語意化變數，淺色／深色模式在同一處切換。介面上每一組「文字色＋背景色」都用程式算過對比，兩種模式皆 ≥ 4.5:1（WCAG AA）。按右上角 🌙 可以即時看深色版。</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {colors.map(c => (
          <li class="overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
            <div class:list={['h-20', c.cls]}></div>
            <div class="p-4">
              <p class="font-extrabold">{c.name}</p>
              <p class="mt-1 text-sm leading-[1.6] text-ink-2">{c.use}</p>
              <p class="mt-2 font-mono text-xs text-ink-2">☀️ {c.light}<br />🌙 {c.dark}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="t-title">
      <h2 id="t-title" class="text-2xl font-extrabold tracking-tight">字體與字級</h2>
      <p class="mt-2 max-w-2xl text-ink-2">英文與數字用圓潤的 <strong>Nunito</strong>，中文用字形完整的 <strong>Noto Sans TC</strong>。字體檔自行託管，不從第三方載入。中文行高 1.8、每行最多約 38 字，眼睛才不會找不到下一行。</p>
      <ul class="mt-6 divide-y divide-line overflow-hidden rounded-[var(--radius-card)] border border-line bg-surface">
        {typeScale.map(t => (
          <li class="grid gap-2 px-5 py-4 sm:grid-cols-[12rem_1fr] sm:items-baseline sm:gap-6">
            <span class="text-sm font-bold text-ink-2">{t.label}・{t.size}</span>
            <span class={t.cls}>不用啃 PDF，也能讀懂 AI 123</span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="s-title">
      <h2 id="s-title" class="text-2xl font-extrabold tracking-tight">形狀與層次</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-[var(--radius-card)] bg-surface p-5 shadow-[var(--shadow-soft)]"><p class="font-extrabold">卡片圓角 16px</p><p class="text-sm text-ink-2">柔和陰影 shadow-soft</p></div>
        <div class="rounded-[var(--radius-card)] bg-surface p-5 shadow-[var(--shadow-lift)]"><p class="font-extrabold">滑過時浮起</p><p class="text-sm text-ink-2">shadow-lift＋上移 4px</p></div>
        <div class="rounded-[var(--radius-card)] border border-line bg-surface p-5"><p class="font-extrabold">間距以 4px 為單位</p><p class="text-sm text-ink-2">觸控目標至少 44px</p></div>
      </div>
    </section>

    <section aria-labelledby="k-title">
      <h2 id="k-title" class="text-2xl font-extrabold tracking-tight">元件</h2>

      <h3 class="mt-8 text-lg font-extrabold">提示卡（四種固定語意）</h3>
      <div class="grid gap-x-6 md:grid-cols-2">
        <Callout type="analogy">用生活例子先抓住感覺。</Callout>
        <Callout type="key">考試一定要記住的重點。</Callout>
        <Callout type="trap">歷屆題目最常挖的坑。</Callout>
        <Callout type="note">延伸補充，不讀也不影響。</Callout>
      </div>

      <h3 class="mt-8 text-lg font-extrabold">誤區卡（原生 details，不需要 JavaScript 也能用）</h3>
      <Misconception claim="AI 一定越大越好">點開後看到解答。用 <code>&lt;details&gt;</code> 實作，鍵盤和螢幕閱讀器都能操作。</Misconception>

      <h3 class="mt-8 text-lg font-extrabold">徽章與按鈕</h3>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <Badge tone="brand">L11302・科目一</Badge>
        <Badge tone="accent">L12202・科目二</Badge>
        <Badge>即將推出</Badge>
        <span class="inline-flex min-h-12 items-center rounded-[var(--radius-btn)] bg-brand px-6 font-extrabold text-on-brand">主要按鈕</span>
        <span class="inline-flex min-h-12 items-center rounded-[var(--radius-btn)] border-2 border-line px-6 font-extrabold">次要按鈕</span>
      </div>

      <h3 class="mt-8 text-lg font-extrabold">判斷流程圖</h3>
      <div class="max-w-[38em]"><DecisionTree client:visible tree={demoTree} /></div>

      <h3 class="mt-8 text-lg font-extrabold">情境測驗卡</h3>
      <div class="max-w-[38em]"><Quiz client:visible lessonId="design-demo" questions={demoQuiz} title="示範測驗卡" /></div>
    </section>

    <section aria-labelledby="r-title">
      <h2 id="r-title" class="text-2xl font-extrabold tracking-tight">響應式（RWD）</h2>
      <p class="mt-2 max-w-2xl text-ink-2">同事手機、電腦都會用，所以以手機為基礎設計，再往大螢幕擴充。</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {breakpoints.map(b => (
          <li class="rounded-[var(--radius-card)] bg-surface-2 p-5">
            <p class="font-mono text-sm font-bold text-brand">{b.range}</p>
            <p class="mt-1 text-lg font-extrabold">{b.name}</p>
            <p class="mt-1 text-[15px] leading-[1.75] text-ink-2">{b.layout}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="a-title">
      <h2 id="a-title" class="text-2xl font-extrabold tracking-tight">無障礙</h2>
      <ul class="mt-4 max-w-2xl list-disc space-y-2 pl-5 leading-[1.8]">
        <li>文字對比符合 WCAG AA；焦點外框清楚（3px 主色）</li>
        <li>觸控目標至少 44×44px；手機底部分頁列在拇指可及範圍</li>
        <li>「跳到主要內容」連結、語意化標題與地標（header／nav／main）</li>
        <li>測驗答對／答錯會用 aria-live 播報；顏色之外另有 ✓✗ 與文字</li>
        <li>尊重「減少動態效果」系統設定</li>
      </ul>
    </section>
  </div>
</BaseLayout>
