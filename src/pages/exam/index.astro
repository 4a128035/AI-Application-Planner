---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import { url } from '../../lib/url'

const features = [
  { emoji: '⏱️', title: '完整模擬考', text: '50 題、限時 75 分鐘，和正式考試一樣。' },
  { emoji: '🎯', title: '主題練習', text: '依評鑑代碼挑題，例如只練 L11203 資料隱私。' },
  { emoji: '📕', title: '錯題本', text: '答錯的題目自動收錄，手機和電腦同步。' },
  { emoji: '📊', title: '學習看板', text: '看到自己在每個主題的答對率，知道該補哪裡。' }
]
---

<BaseLayout title="模擬考" description="讀書會成員限定的模擬考：Google 登入、伺服器端批改。">
  <PageHero emoji="⏱️" title="模擬考" lead="題庫不放在這個公開網站裡。讀書會成員用 Google 帳號登入後才能作答，交卷後由伺服器批改。" />

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="flex flex-col items-start gap-4 rounded-[var(--radius-card)] border border-line bg-surface p-6 shadow-[var(--shadow-soft)] sm:flex-row sm:items-center">
      <span aria-hidden="true" class="text-4xl">🔒</span>
      <div class="flex-1">
        <p class="text-lg font-extrabold">建置中：讀書會成員限定</p>
        <p class="mt-1 text-ink-2">登入和題庫完成後，這裡會出現「用 Google 登入」按鈕。</p>
      </div>
      <button type="button" disabled class="min-h-12 cursor-not-allowed rounded-[var(--radius-btn)] bg-surface-2 px-6 font-extrabold text-ink-2">用 Google 登入</button>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {features.map(f => (
        <li class="rounded-[var(--radius-card)] bg-surface-2 p-5">
          <span aria-hidden="true" class="text-3xl">{f.emoji}</span>
          <p class="mt-3 text-lg font-extrabold">{f.title}</p>
          <p class="mt-1 text-[15px] leading-[1.75] text-ink-2">{f.text}</p>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-ink-2">
      想先試試題目長什麼樣子？到<a class="font-bold text-brand underline underline-offset-4" href={url('l11/ml-types/#quiz')}>機器學習的四種學法</a>做示範題。
    </p>
  </div>
</BaseLayout>
